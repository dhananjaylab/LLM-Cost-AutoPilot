# syntax=docker/dockerfile:1
# ── Worker / Beat Dockerfile ──────────────────────────────────────────────────
#
# Same build pattern as Dockerfile.api.
#
# Build context: repo root

ARG PYTHON_VERSION=3.11
ARG UV_VERSION=0.5.15

# ── Stage 0: uv downloader ────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_SYSTEM_PYTHON=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_NO_CACHE=1
ENV PYTHONDONTWRITEBYTECODE=1

# scikit-learn needs gcc
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY pyproject.toml ./
COPY libs/core/pyproject.toml ./libs/core/
COPY apps/api/pyproject.toml ./apps/api/
COPY apps/worker/pyproject.toml ./apps/worker/

COPY libs/   ./libs/
COPY apps/worker/ ./apps/worker/
COPY apps/api/    ./apps/api/

# scikit-learn, joblib, numpy, sentence-transformers, celery, and redisvl
# are all declared in libs/core/pyproject.toml as of Phase 3 (the API
# process needs the classifier and semantic cache too, not just the
# worker) — uv sync pulls them in transitively via the workspace
# dependency, so no ad hoc `uv pip install` is needed here anymore.
RUN uv sync --no-dev --package llm-autopilot-worker

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim AS runtime

RUN groupadd --gid 1001 autopilot \
 && useradd  --uid 1001 --gid autopilot --shell /bin/bash --create-home autopilot

WORKDIR /app

COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /build/libs        /app/libs
COPY --from=builder /build/apps/worker /app/apps/worker
COPY --from=builder /build/apps/api    /app/apps/api

ENV PYTHONPATH=/app/libs/core:/app/apps/worker:/app/apps/api
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Hugging Face cache dir (sentence-transformers model download)
ENV HF_HOME=/app/.cache/huggingface
RUN mkdir -p /app/.cache/huggingface && chown -R autopilot:autopilot /app/.cache

USER autopilot
