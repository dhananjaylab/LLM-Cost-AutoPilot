# .env.example
# Copy to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
#
# Usage: cp .env.example .env

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5432/autopilot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Get from:
#   OpenAI    → https://platform.openai.com/api-keys
#   Anthropic → https://console.anthropic.com/settings/keys
#   Google    → https://aistudio.google.com/app/apikey
#   Groq      → https://console.groq.com/keys

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ── Ollama ────────────────────────────────────────────────────────────────────
# When running via Docker Compose, use the service name:
OLLAMA_BASE_URL=http://ollama:11434
# When running locally outside Docker:
# OLLAMA_BASE_URL=http://localhost:11434

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=autopilot       # change in production

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
API_WORKERS=2

# ── Observability (optional) ──────────────────────────────────────────────────
ENABLE_TRACING=false
# OTLP_ENDPOINT=http://jaeger:4318  # uncomment to enable distributed tracing

# ── Semantic cache ────────────────────────────────────────────────────────────
CACHE_SIMILARITY_THRESHOLD=0.92  # lower = more cache hits, lower fidelity
REDIS_CACHE_TTL=3600             # seconds

# ── Verification & escalation ─────────────────────────────────────────────────
CLASSIFIER_CONFIDENCE_THRESHOLD=0.85
VERIFICATION_SAMPLE_RATE_LOW_CONFIDENCE=1.0   # 100% verify low-confidence routings
VERIFICATION_SAMPLE_RATE_HIGH_CONFIDENCE=0.05  # 5% verify high-confidence routings
VERIFICATION_RANDOM_BASELINE_RATE=0.02         # 2% always verify (drift detection)
ESCALATION_QUALITY_THRESHOLD=0.75
ESCALATION_MAX_LATENCY_MS=5000

# ── Admin API (Phase 5) ────────────────────────────────────────────────────────
# Shared-secret gate on PUT /v1/admin/routing-config only (GETs stay public).
# Leave unset to disable the endpoint (it responds 503 rather than 401, so
# it's obvious from the outside that it's turned off, not just failing auth).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# How long (seconds) a replica may go without re-checking Postgres for a
# newer promoted routing config. The replica that serves a PUT refreshes
# itself immediately regardless of this value — see routing.py.
ROUTING_CONFIG_CACHE_TTL_SECONDS=30
